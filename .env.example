# ==============================================================================
# Grid-Guard Environment Configuration Template
# Copy this template to .env for local runtime overrides.
# Do not commit real secrets or production credentials to version control.
# ==============================================================================

# FastAPI Service Configuration
PORT=8000
GRID_GUARD_API__HOST=0.0.0.0
GRID_GUARD_API__PORT=8000
GRID_GUARD_API__WORKERS=1
GRID_GUARD_API__RELOAD=false
GRID_GUARD_API__TITLE="Grid-Guard NTL Detection API"
GRID_GUARD_API__VERSION="0.1.0"

# CORS Configuration (comma-separated origins allowed to call the API)
# In production, include your deployed frontend URL (e.g. https://grid-guard-frontend.onrender.com)
CORS_ORIGINS="https://grid-guard-frontend.onrender.com,http://localhost:5173,http://localhost:3000"

# Model & Artifact Storage Paths
GRID_GUARD_API__MODEL_PATH="artifacts/cost_sensitive/champion_model.txt"

# Operational Financial Assumptions & Decisioning
GRID_GUARD_FINANCIAL__DEFAULT_TARIFF=6.0
GRID_GUARD_FINANCIAL__DISPATCH_COST=500.0
GRID_GUARD_FINANCIAL__UNDETECTED_CYCLES=12
GRID_GUARD_DECISION__DECISION_RULE=env

# Logging
GRID_GUARD_LOG_LEVEL=INFO

# Frontend Vite Configuration (used at frontend build-time)
# In production on Render, set this to your deployed FastAPI Web Service URL
VITE_API_BASE_URL=https://grid-guard-api.onrender.com
