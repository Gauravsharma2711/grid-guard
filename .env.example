# Grid-Guard Environment Configuration Template
# Copy to .env for local runtime overrides. Do not commit secrets to version control.

# FastAPI Service Configuration
GRID_GUARD_API__HOST=0.0.0.0
GRID_GUARD_API__PORT=8000
GRID_GUARD_API__WORKERS=1
GRID_GUARD_API__RELOAD=false
GRID_GUARD_API__TITLE="Grid-Guard NTL Detection API"
GRID_GUARD_API__VERSION="1.0.0"

# Streamlit Dashboard Configuration
GRID_GUARD_API_URL=http://localhost:8000
GRID_GUARD_API_TIMEOUT=25.0
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Operational Financial Defaults
GRID_GUARD_FINANCIAL__DISPATCH_COST=100.0
GRID_GUARD_FINANCIAL__DEFAULT_TARIFF=0.15
GRID_GUARD_FINANCIAL__UNDETECTED_CYCLES=12
GRID_GUARD_DECISION__DECISION_RULE=env

# Logging
GRID_GUARD_LOG_LEVEL=INFO
