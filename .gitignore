# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Project Data Directories (keep directory structure via .gitkeep)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep

# Explicitly ignore raw datasets and data formats
*.csv
!tests/fixtures/*.csv
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.pickle
*.zip
*.tar.gz
*.tar
artifacts/baseline/*.txt
artifacts/imbalance/*.txt
artifacts/cost_sensitive/*.txt
artifacts/decision/*.csv
!artifacts/decision/top_100_inspection_tickets.csv
artifacts/explainability/*.parquet
!artifacts/explainability/enriched_top_100_tickets.csv
!artifacts/explainability/global_shap_importance.csv

# MLflow tracking artifacts & runs
mlruns/
.mlruns/
mlartifacts/
*.db
mlflow.db

# OS / Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Secrets & Local Overrides
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Build / Distribution
build/
dist/
*.egg-info/
.eggs/

# Frontend (Node / Vite)
node_modules/
frontend/node_modules/
frontend/dist/

